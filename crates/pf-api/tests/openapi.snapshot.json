      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Create, edit, check and read sandboxed household parts.",
    "title": "partifactory",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/blobs": {
      "post": {
        "operationId": "putBlob",
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Successful result"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Operation error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Upload a content-addressed blob (25 MiB maximum)"
      }
    },
    "/api/v1/blobs/missing": {
      "post": {
        "operationId": "missingBlobs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "hashes": {
                    "items": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "hashes"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Successful result"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Operation error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Return hashes that need uploading"
      }
    },
    "/api/v1/part_check": {
      "post": {
        "description": "Use the mobile viewport unless checking a desktop layout.",
        "operationId": "part_check",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "packing"
              },
              "schema": {
                "$ref": "#/components/schemas/part_checkInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Operation result; failed builds are successful writes."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Correct the error using hint and details."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Render a part and report browser errors."
      }
    },
    "/api/v1/part_create": {
      "post": {
        "description": "Use live: after_check for pages.",
        "operationId": "part_create",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "content": "Pack passports",
                "kind": "text",
                "name": "packing",
                "request_id": "example-create",
                "title": "Packing"
              },
              "schema": {
                "$ref": "#/components/schemas/part_createInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Operation result; failed builds are successful writes."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Correct the error using hint and details."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Reserve a name and create a part."
      }
    },
    "/api/v1/part_data": {
      "post": {
        "description": "Use if_rev for compare-and-set; mutations need request_id.",
        "operationId": "part_data",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "action": "list",
                "name": "packing"
              },
              "schema": {
                "$ref": "#/components/schemas/part_dataInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Operation result; failed builds are successful writes."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Correct the error using hint and details."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Read or change shared or personal documents and snapshots."
      }
    },
    "/api/v1/part_edit": {
      "post": {
        "description": "Read exact anchors and hashes with part_get; retry with the same request_id.",
        "operationId": "part_edit",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "edits": [
                  {
                    "new_str": "passports and chargers",
                    "old_str": "passports",
                    "op": "replace"
                  }
                ],
                "name": "packing",
                "request_id": "example-edit"
              },
              "schema": {
                "$ref": "#/components/schemas/part_editInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Operation result; failed builds are successful writes."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Correct the error using hint and details."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Apply ordered edits atomically, or one lifecycle mode."
      }
    },
    "/api/v1/part_get": {
      "post": {
        "description": "Use file and range for large parts.",
        "operationId": "part_get",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "name": "packing"
              },
              "schema": {
                "$ref": "#/components/schemas/part_getInput"
              }
            }
          },
          "required": true
        },
        "responses": {
