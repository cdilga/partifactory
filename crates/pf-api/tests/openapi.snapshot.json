{
  "components": {
    "schemas": {
      "Action": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "do": {
                "const": "click",
                "type": "string"
              },
              "selector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "x": {
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "y": {
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "do"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "do": {
                "const": "type",
                "type": "string"
              },
              "selector": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "do",
              "selector",
              "text"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "do": {
                "const": "wait_ms",
                "type": "string"
              },
              "ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "do",
              "ms"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "do": {
                "const": "eval_return",
                "type": "string"
              },
              "expr": {
                "type": "string"
              }
            },
            "required": [
              "do",
              "expr"
            ],
            "type": "object"
          }
        ]
      },
      "Edit": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "new_str": {
                "type": "string"
              },
              "old_str": {
                "type": "string"
              },
              "op": {
                "const": "replace",
                "type": "string"
              }
            },
            "required": [
              "op",
              "old_str",
              "new_str"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "blob": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "file": {
                "type": "string"
              },
              "if_match": {
                "$ref": "#/components/schemas/Match"
              },
              "op": {
                "const": "write",
                "type": "string"
              }
            },
            "required": [
              "op",
              "file",
              "if_match"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "if_match": {
                "$ref": "#/components/schemas/Match"
              },
              "op": {
                "const": "delete",
                "type": "string"
              }
            },
            "required": [
              "op",
              "file",
              "if_match"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "if_match": {
                "$ref": "#/components/schemas/Match"
              },
              "op": {
                "const": "rename",
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "op",
              "from",
              "to",
              "if_match"
            ],
            "type": "object"
          }
        ]
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "invalid_input",
                  "invalid_edit",
                  "unknown_field",
                  "unauthenticated",
                  "forbidden",
                  "forbidden_view_only",
                  "not_found",
                  "file_not_found",
                  "name_taken",
                  "if_match_failed",
                  "file_exists",
                  "request_id_reused",
                  "too_large",
                  "anchor_not_found",
                  "anchor_ambiguous",
                  "base_unknown",
                  "invalid_against_base",
                  "quota_exceeded",
                  "rate_limited",
                  "storage_full",
                  "renderer_unavailable",
                  "internal"
                ],
                "type": "string"
              },
              "details": {
                "type": "object"
              },
              "hint": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "hint",
              "retryable",
              "details"
            ],
            "type": "object"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "type": "object"
      },
      "FileInput": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "properties": {
              "blob": {
                "type": "string"
              }
            },
            "required": [
              "blob"
            ],
            "type": "object"
          }
        ],
        "description": "One file in a write: inline text, or a blob already uploaded."
      },
      "FileMap": {
        "additionalProperties": {
          "$ref": "#/components/schemas/FileInput"
        },
        "description": "`{path: str | {blob}}`, refusing duplicate keys (a JSON object may repeat a key; we don't\nlet the last one silently win).",
        "type": "object"
      },
      "Match": {
        "description": "Required even for null: omission must never silently mean “create”."
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "shared_data_writers": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "default": null,
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "title": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "part_checkInput": {
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "include_base64": {
            "default": false,
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "version": true,
          "viewport": {
            "type": [
              "string",
              "null"
            ]
          },
          "wait_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "part_createInput": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "required": [
                "title",
                "request_id"
              ]
            },
            "if": {
              "properties": {
                "check_only": {
                  "const": true
                }
              },
              "required": [
                "check_only"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "title"
                  ]
                },
                {
                  "required": [
                    "name"
                  ]
                }
              ]
            }
          }
        ],
        "description": "The `part_create` arguments, exactly as the contract lists them.",
        "properties": {
          "check_only": {
            "type": "boolean"
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_in": {
            "type": [
              "string",
              "null"
            ]
          },
          "files": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FileMap"
              },
              {
                "type": "null"
              }
            ]
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "live": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "shared_data_writers": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshots": {
            "type": [
              "string",
              "null"
            ]
          },
          "space": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [],
        "title": "CreateRequest",
        "type": "object"
      },
      "part_dataInput": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "set",
                    "delete",
                    "snapshot_restore",
                    "reset"
                  ]
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "request_id"
              ]
            }
          }
        ],
        "properties": {
          "action": {
            "default": "",
            "type": "string"
          },
          "collection": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "confirm": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          },
          "cursor": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "default": null
          },
          "doc_id": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "if_rev": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "limit": {
            "default": null,
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "default": "",
            "type": "string"
          },
          "prefix": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "scope": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_id": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "action"
        ],
        "title": "PartDataRequest",
        "type": "object"
      },
      "part_editInput": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "edits"
            ]
          },
          {
            "required": [
              "restore"
            ]
          },
          {
            "required": [
              "delete"
            ]
          },
          {
            "required": [
              "undelete"
            ]
          },
          {
            "required": [
              "rebuild"
            ]
          },
          {
            "required": [
              "meta"
            ]
          }
        ],
        "properties": {
          "base_version": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "check": {
            "default": false,
            "type": "boolean"
          },
          "delete": {
            "const": true
          },
          "edits": {
            "default": null,
            "items": {
              "$ref": "#/components/schemas/Edit"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": [
              "array",
              "null"
            ]
          },
          "live": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Meta"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "name": {
            "default": "",
            "type": "string"
          },
          "rebuild": {
            "const": true
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "restore": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "undelete": {
            "const": true
          },
          "wait": {
            "default": null,
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
