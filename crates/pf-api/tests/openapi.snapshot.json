          "request_id"
        ],
        "title": "EditRequest",
        "type": "object"
      },
      "part_getInput": {
        "additionalProperties": false,
        "description": "The `part_get` arguments.",
        "properties": {
          "build": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "diff_from": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "diff_to": {
            "default": null,
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "file": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "history": {
            "default": false,
            "type": "boolean"
          },
          "name": {
            "default": "",
            "type": "string"
          },
          "range": {
            "default": null,
            "items": {
              "format": "int64",
