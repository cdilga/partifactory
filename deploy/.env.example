# Replace the image reference with release/digest.txt. Never use a floating tag.
PF_IMAGE=registry.example.com/household/partifactory@sha256:<release-digest>
PF_DOMAIN_APEX=example.com
PF_SITE_CONFIG=./private/site.toml
PF_SESSION_KEY_FILE=./private/session_key
PF_CAP_HMAC_KEY_FILE=./private/cap_hmac_key
PF_METRICS_TOKEN_FILE=./private/metrics_token
PF_IDP_CLIENT_SECRET_FILE=./private/idp_client_secret
# Enable both the setting and compose profile when browser checks are wanted.
PF_RENDER_ENABLED=false
# COMPOSE_PROFILES=proxy,render
PF_TLS_CERT=./private/cert.pem
PF_TLS_KEY=./private/key.pem
PF_HTTPS_BIND=127.0.0.1
PF_HTTPS_PORT=8443
PF_OPS_PORT=9090
