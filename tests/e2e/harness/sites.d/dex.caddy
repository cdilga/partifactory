# Harness-only extra sites (mounted at /etc/caddy/sites.d/). The two Dex instances sit behind
# the same proxy and cert as partifactory, at their own explicit hosts, which win over the
# wildcard.

dex.{$PF_APEX:pf.test} {
	import pf_proxy
	reverse_proxy dex:5556
}

dex2.{$PF_APEX:pf.test} {
	import pf_proxy
	reverse_proxy dex2:5556
}
