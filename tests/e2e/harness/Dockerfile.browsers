FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea
LABEL pf.harness="1"
# A mirror can serve a corrupt index; start clean and retry rather than fail the whole e2e job.
RUN for i in 1 2 3; do rm -rf /var/lib/apt/lists/* \
      && apt-get update -qq -o Acquire::Retries=3 \
      && apt-get install -y --no-install-recommends libnss3-tools && break; \
      [ "$i" = 3 ] && exit 1; sleep 10; done \
    && rm -rf /var/lib/apt/lists/*
